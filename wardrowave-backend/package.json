{
  "name": "wardrowave-backend",
  "version": "1.0.0",
  "description": "WardroWave backend API built with Express, MongoDB, and Mongoose",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:integration": "cross-env RUN_MONGO_INTEGRATION=true node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/integration",
    "lint": "eslint .",
    "audit": "npm audit --omit=dev",
    "seed": "node scripts/seed.js",
    "create-indexes": "node scripts/create-indexes.js"
  },
  "keywords": [
    "wardrowave",
    "rental",
    "fashion",
    "express",
    "mongodb"
  ],
  "author": "Copilot",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^1.1.0",
    "express-rate-limit": "^7.0.0",
    "firebase-admin": "^12.4.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.0.0",
    "hpp": "^0.2.0",
    "http-status-codes": "^1.2.2",
    "mongoose": "^8.8.2",
    "multer": "^2.5.0",
    "nanoid": "^5.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.15.1",
    "pino": "^9.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "razorpay": "^2.9.8",
    "slugify": "^1.6.6",
    "streamifier": "^0.1.1",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.0",
    "supertest": "^7.0.0"
  }
}
