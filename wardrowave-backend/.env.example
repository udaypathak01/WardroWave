NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
ENABLE_DOCS=false
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://localhost:27017/wardrowave?replicaSet=rs0
CORS_ORIGINS=http://localhost:5173,https://wardrowave.in
FIREBASE_PROJECT_ID=wardrowave-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=secret
RAZORPAY_WEBHOOK_SECRET=webhook-secret
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo
CLOUDINARY_FOLDER=wardrowave
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
REQUIRE_VERIFIED_EMAIL=true
SMTP_USER=user
SMTP_PASS=password
MAIL_FROM=hello@wardrowave.in
SUPPORT_EMAIL=support@wardrowave.in
ADMIN_EMAILS=admin@wardrowave.in
SUPERADMIN_EMAILS=
ADMIN_REAUTH_MAX_AGE_SECONDS=300
ADMIN_SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
ADMIN_SENSITIVE_RATE_LIMIT_MAX=30
SEED_TEST_USER_EMAIL=
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
MIN_LEAD_DAYS=2
MAX_ADVANCE_DAYS=180
HOLD_MINUTES=15
GST_PERCENT=12
DELIVERY_FEE=9900
FREE_DELIVERY_ABOVE=500000
LATE_FEE_MULTIPLIER=1.5
FREE_CANCEL_HOURS=48
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
OBSERVABILITY_ENABLED=false
